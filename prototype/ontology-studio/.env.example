KNOWLEDGEOS_API_BASE_URL=http://127.0.0.1:8787
# Users sign in with their own backend token in Studio. No shared service token.
# Optional authoring assistant gateway (knowledgeos-assistant). Leave unset to hide model-backed drafting.
KNOWLEDGEOS_ASSISTANT_BASE_URL=http://127.0.0.1:8790
# Optional KnowledgeOS MCP adapter (knowledgeos-mcp) used to show agent connection settings.
KNOWLEDGEOS_MCP_BASE_URL=http://127.0.0.1:8791
