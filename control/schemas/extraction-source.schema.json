{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgeos.local/schemas/extraction-source.schema.json",
  "title": "KnowledgeOS Extraction Source Envelope",
  "description": "Provider-neutral normalized source input for candidate extraction.",
  "type": "object",
  "required": ["version", "id", "kind", "locator", "content_hash", "captured_at", "segments"],
  "properties": {
    "version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "locator": { "type": "string", "minLength": 1 },
    "mime_type": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "start", "end"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
